# Conexão via pooler do Supabase (porta 6543) usada pela API
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) usada pelo Prisma nas migrations
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Porta da API
PORT=3000

# Firebase Admin (login dos operadores do dashboard)
# Copie os campos do JSON da conta de serviço:
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID="seu-projeto-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com"
# Mantenha entre aspas e com os "\n" do JSON, tudo em uma linha
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Chave pública do app Web do Firebase (apiKey do firebaseConfig).
# A API não usa; serve para gerar um token de teste fazendo login como o dashboard.
FIREBASE_WEB_API_KEY="sua-api-key-web"

# Operador admin criado pelo seed (opcional)
SEED_ADMIN_EMAIL="admin@provedorteste.com"
SEED_ADMIN_PASSWORD="admin123"
